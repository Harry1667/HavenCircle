<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.gomiigo.CamMenuApp.HavenCircle.refresh</string>
	</array>
	<!-- 宣告 App 支援繁體中文：系統元件（貼上鈕 PasteButton、分享面板等）依 App 宣告的語系
	     決定顯示語言；沒宣告就只有 en，中文裝置上會顯示英文「Paste」。 -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hant</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.gomiigo.CamMenuApp.HavenCircle</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>havencircle</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>location</string>
	</array>
	<!-- 關閉 Firebase 的 AppDelegate swizzling：在 SwiftUI @UIApplicationDelegateAdaptor 環境下，
	     Firebase proxy 攔截 didRegisterForRemoteNotificationsWithDeviceToken 卻不轉發給 App 自己的方法，
	     導致 APNs 權杖不會上傳到中繼站。改為手動整合（App 已自行設定 apnsToken 與 delegate、
	     並在 didReceiveRemoteNotification 呼叫 appDidReceiveMessage）。 -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<!-- 出口合規：App 只使用 iOS 系統內建的 HTTPS/TLS 標準加密（Firebase、CloudKit 皆走此），
	     屬於非豁免加密的豁免範圍。標明 NO 後，每次上傳 TestFlight/App Store 都免再手動回答加密合規問題。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
