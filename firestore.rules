rules_version = '2';

// HavenCircle 家庭圈 Firestore 安全規則。
// 核心原則：只有「同一家庭圈的成員」才能讀寫彼此的家庭資料、位置、安否回報。
// 位置是敏感個資，這條規則寫錯＝任何人可讀到別人的精確位置，務必謹慎。
service cloud.firestore {
  match /databases/{database}/documents {

    // 判斷 request.auth.uid 是否為某家庭圈的成員（用根文件的 memberUids 陣列）
    function isMember(familyId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberUids;
    }

    // 判斷 request.auth.uid 是否為某家庭圈的圈主（用根文件的 ownerUid 欄位）。
    // 只給「解散家庭圈」這條路徑額外授權用：圈主刪除其他成員留下的子文件／邀請碼，
    // 讓解散不再留孤兒資料。家庭根文件一旦被刪，這個 get() 會失敗而整條規則判為 false，
    // 這是刻意的：根文件必須是解散順序中最後被刪的一個。
    function isOwner(familyId) {
      return request.auth != null
        && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid;
    }

    match /families/{familyId} {
      // 讀：只有家庭成員能讀家庭根文件
      allow read: if isMember(familyId);

      // 建立：登入者建立自己擁有的家庭圈（擁有者與唯一初始成員都是自己）
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      // 更新：已是成員可更新；或「新成員用邀請碼加入」——只允許把自己加進 memberUids，不能動別的欄位、不能刪掉既有成員
      allow update: if isMember(familyId)
        || (
          request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.hasOnly(resource.data.memberUids.concat([request.auth.uid]))
        );

      // 刪除：只有圈主能解散家庭圈
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // 成員：家庭成員可讀；每人只能新增/修改自己的成員文件。
      // 刪除另外開一條：本人可刪自己的（離開家庭圈），或圈主可刪任何人的（解散家庭圈時
      // 清掉其他成員留下的成員文件，不再留孤兒資料）——create/update 條件完全不變，
      // 只是把原本涵蓋 delete 的 write 拆開，delete 用更寬的條件。
      match /members/{uid} {
        allow read: if isMember(familyId);
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && (request.auth.uid == uid || isOwner(familyId));
      }

      // 即時位置：家庭成員可讀；每人只能新增/修改自己的位置（同意式分享的技術保證）。
      // 刪除同 members：本人或圈主（解散時清掉其他成員留下的位置文件）。
      match /locations/{uid} {
        allow read: if isMember(familyId);
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && (request.auth.uid == uid || isOwner(familyId));

        // 24 小時軌跡點：家庭成員可讀；只有本人能寫入（同意式分享的技術保證）；點不可修改。
        // 刪除：本人（關閉分享時清空、每次上傳順手清過期點）或圈主（解散家庭圈清子集合）。
        // 每筆帶 expireAt（clientAt + 24 小時），建議另設 Firestore TTL policy 當第二道保險。
        match /trail/{pointId} {
          allow read: if isMember(familyId);
          allow create: if request.auth != null && request.auth.uid == uid;
          allow update: if false;
          allow delete: if request.auth != null && (request.auth.uid == uid || isOwner(familyId));
        }
      }

      // 守護地點到達／離開事件：家庭成員可讀；只能以自己的 uid 新增；不可改；
      // 刪除限本人（關閉分享時清掉自己的、過期清理）或圈主（解散家庭圈）。
      // 文件帶 expireAt（建立後 24 小時），建議另設 Firestore TTL policy 自動清除。
      match /arrivals/{eventId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId) && request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if request.auth != null
          && (resource.data.uid == request.auth.uid || isOwner(familyId));
      }

      // 安否回報：家庭成員可讀、可發、可標記已讀（更新）；一般情況下不開放刪除，
      // 只有圈主解散家庭圈時能刪（避免解散後留下永久孤兒資料）。
      match /pings/{pingId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId);
        allow update: if isMember(familyId);
        allow delete: if isOwner(familyId);
      }
    }

    // 邀請碼索引：登入者可讀（輸碼加入時查 familyId）與建立；不可竄改。
    // 刪除只開放給該邀請碼所屬家庭圈的圈主（解散家庭圈、或重新產生邀請碼時清掉舊碼）——
    // 家庭文件已被刪除時 get() 求值失敗、規則判為 false，是可接受的殘留：解散順序保證
    // 邀請碼一定先於根文件被刪，只有「解散中途斷網」這種極端情況才會留下無法再刪的舊碼，
    // 之後交由 Firestore 原生 TTL 政策（expiresAt 欄位）清除。
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null
        && isOwner(resource.data.familyId);
    }
  }
}
